# ===========================================
# AGRIDOM DASHBOARD - VARIÁVEIS DE AMBIENTE
# ===========================================
# Copie este arquivo para .env e configure com seus dados reais

# Ambiente de execução (development ou production)
NODE_ENV=production

# URLs da Aplicação
# Para desenvolvimento:
# FRONTEND_URL=http://localhost:3000
# API_URL=http://localhost:3000/api
# CORS_ORIGIN=http://localhost:3000

# Para produção (projeto unificado na Vercel):
FRONTEND_URL=https://crm.kaizenmidias.com
API_URL=https://crm.kaizenmidias.com/api
CORS_ORIGIN=https://crm.kaizenmidias.com
PORT=3000

# ===========================================
# CONFIGURAÇÕES SUPABASE (ÚNICO BANCO)
# ===========================================
# O mesmo banco Supabase é usado tanto em desenvolvimento quanto em produção
# Substitua pelos dados do seu projeto Supabase
SUPABASE_URL=https://qwbpruywwfjadkudegcj.supabase.co
SUPABASE_ANON_KEY=SUA_CHAVE_ANON_AQUI
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SERVICE_ROLE_AQUI
SUPABASE_JWT_SECRET=seu_jwt_secret_aqui

# Configurações PostgreSQL (Supabase)
POSTGRES_HOST=db.qwbpruywwfjadkudegcj.supabase.co
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_postgres
POSTGRES_URL=postgresql://postgres:sua_senha@db.qwbpruywwfjadkudegcj.supabase.co:5432/postgres

# ===========================================
# CONFIGURAÇÕES JWT
# ===========================================
JWT_SECRET=sua_chave_secreta_jwt_muito_segura_aqui
JWT_EXPIRES_IN=24h

# Configurações de Segurança
BCRYPT_ROUNDS=12

# ===========================================
# CONFIGURAÇÕES DO FRONTEND (VITE)
# ===========================================
# Para desenvolvimento:
# VITE_API_BASE_URL=http://localhost:8080/api
# VITE_AUTH_API_BASE_URL=http://localhost:8080/auth

# Para produção:
VITE_API_BASE_URL=https://crm.kaizenmidias.com/api
VITE_AUTH_API_BASE_URL=https://your-backend.vercel.app/auth
VITE_SUPABASE_URL=https://qwbpruywwfjadkudegcj.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anonima_aqui

# ===========================================
# PROSPECCAO SEGURA
# ===========================================
# Configure estes valores no backend/Vercel, nunca no frontend.
APIFY_TOKEN=seu_token_apify
APIFY_GOOGLE_MAPS_ACTOR=username/actor-google-maps
APIFY_INSTAGRAM_ACTOR=username/actor-instagram
APIFY_TIMEOUT_MINUTES=10
APIFY_POLL_INTERVAL_SECONDS=5

CASA_DOS_DADOS_API_KEY=sua_api_key_casa_dos_dados
CASA_DOS_DADOS_API_VERSION=v5
CASA_DOS_DADOS_BASE_URL=https://api.casadosdados.com.br

WHATSAPP_VALIDATION_PROVIDER=
WHATSAPP_VALIDATION_API_KEY=
WHATSAPP_VALIDATION_CACHE_DAYS=30

# Evolution API - validação de WhatsApp
EVOLUTION_API_BASE_URL=https://evolution.sua-instancia.com
EVOLUTION_API_KEY=sua_chave_evolution_api
EVOLUTION_API_INSTANCE=kaizen-validation
